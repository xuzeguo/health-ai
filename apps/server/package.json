{
  "name": "@health-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts ../../apps/web/test/*.test.ts",
    "test:provider": "node --import tsx ../../scripts/test-provider.ts"
  },
  "dependencies": {
    "@health-ai/shared": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "openai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.0.0"
  }
}
